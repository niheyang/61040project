{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "bun", "node"],
    "paths": { "@design/*": ["../design/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "../generated/wire.ts", "../src/text.d.ts"]
}
