{
  "private": true,
  "type": "module",
  "name": "catchup",
  "packageManager": "bun@1.4.2",
  "overrides": { "bson": "7.2.0" },
  "dependencies": {
    "@mit-sdg/sync-engine": "1.1.0",
    "@mit-sdg/sync-engine-http": "1.1.0",
    "mongodb": "7.7.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": ">=6 <7",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "scripts": {
    "generate": "sync-engine artifacts pin",
    "check": "sync-engine check && sync-engine artifacts check && tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "check:design": "sync-engine check-design design/concepts/*.md design/types.md design/compositions/*.md",
    "dev": "bun run db:up && bun run --parallel dev:backend dev:frontend",
    "dev:backend": "bun --watch src/main.ts",
    "dev:frontend": "vite --config web/vite.config.ts",
    "start": "bun run dev",
    "build": "vite build --config web/vite.config.ts",
    "db:up": "podman compose up -d mongo && bun scripts/check-db.ts --wait",
    "db:down": "podman compose down",
    "db:check": "bun scripts/check-db.ts",
    "db:logs": "podman compose logs mongo",
    "test": "bun test"
  }
}
